# Скопируйте в .env и заполните значениями из `npx supabase status`.
# В VITE_* — только публичные значения: они попадают в JS-бандл.

# Фронтенд (публичные)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY из `npx supabase status`>
# Публичный VAPID-ключ (пара — в supabase/functions/.env): npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Скрипты конвейера (tenant:publish, owner:invite) — только локально/CI, НЕ VITE_*
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=<SECRET_KEY из `npx supabase status`>
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Секреты Edge Functions задаются в supabase/functions/.env (этап 4+):
# BOOKING_TOKEN_SECRET=<openssl rand -base64 32>
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT=mailto:...   (npx web-push generate-vapid-keys)
# LLM_BASE_URL=   LLM_API_KEY=   LLM_MODEL=     (пусто → «AI недоступен»)
