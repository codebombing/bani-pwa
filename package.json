{
  "name": "bani-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/shared/db.types.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:functions": "supabase functions serve",
    "owner:invite": "tsx scripts/owner/invite.ts",
    "tenant:new": "tsx scripts/tenant/new.ts",
    "tenant:validate": "tsx scripts/tenant/validate.ts",
    "tenant:publish": "tsx scripts/tenant/publish.ts",
    "tenant:verify": "tsx scripts/tenant/verify.ts",
    "tenant:placeholders": "tsx scripts/tenant/placeholders.ts",
    "tenant:seed": "tsx scripts/tenant/seed.ts",
    "demo:publish": "tsx scripts/tenant/publish.ts demo-banya demo-sauna24",
    "check:all": "npm run typecheck && npm run lint && npm test && npm run build && npm run tenant:seed -- --check && npm run tenant:validate -- demo-banya demo-sauna24"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.13",
    "@astryxdesign/theme-neutral": "^0.7.13",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.13",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
